APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8200
APP_ALLOWED_HOSTS=127.0.0.1,localhost
APP_ALLOWED_ORIGINS=http://127.0.0.1:8200,http://localhost:8200
APP_COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quantdesk
DB_USER=quantdesk
DB_PASSWORD=change-me
DB_SSL_REQUIRED=true
DB_SSL_VERIFY_IDENTITY=true
DB_SSL_CA=/secure/path/to/mysql-ca.pem

# 使用 `python -m quantdesk_v2.cli generate-secrets` 生成。
JWT_SECRET=change-me-at-least-32-characters
CREDENTIAL_MASTER_KEY=replace-with-fernet-key

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOW_PUBLIC_REGISTRATION=true

# USDⓈ-M Futures 官方生产环境；仅允许生产或官方 Demo HTTPS 域名。
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_PORTFOLIO_BASE_URL=https://papi.binance.com
BINANCE_FUTURES_TIMEOUT_SECONDS=10
BINANCE_FUTURES_RECV_WINDOW_MS=5000
# 进程级实盘 Kill Switch。只有设为 true 且用户在实盘页再次确认后才会下单。
BINANCE_LIVE_TRADING_ENABLED=false
BINANCE_LIVE_TRADING_INTERVAL_SECONDS=30

# 可选的服务端回退：用户未在“系统设置 → API 凭证”配置默认 AI 模型时，
# 策略中心才使用此 OpenAI Responses API；未配置则使用本地语义预览。
# 用户自己的模型密钥通过页面录入并使用 CREDENTIAL_MASTER_KEY 加密，所有密钥均不下发到浏览器。
OPENAI_API_KEY=
OPENAI_STRATEGY_MODEL=gpt-5.6-luna
OPENAI_STRATEGY_TIMEOUT_SECONDS=20
DEEPSEEK_OPTIMIZER_TIMEOUT_SECONDS=120
DEEPSEEK_OPTIMIZER_MAX_TOKENS=16000

# Finnhub token is server-only. Generate a fresh token in Finnhub Dashboard.
FINNHUB_API_KEY=
UNUSUAL_WHALES_API_KEY=
EXTERNAL_NEWS_API_KEY=
EXTERNAL_NEWS_WS_POLL_SECONDS=2
# Copy the current Finnhub Dashboard webhook Secret here. Rotate any Secret
# that has previously been pasted into chat, tickets, or logs.
FINNHUB_WEBHOOK_SECRET=
FINNHUB_BASE_URL=https://finnhub.io
FINNHUB_TIMEOUT_SECONDS=5
FINNHUB_MARKET_STATUS_CACHE_SECONDS=30
FINNHUB_MARKET_STATUS_STALE_SECONDS=900
FINNHUB_QUOTE_POLL_SECONDS=2
FINNHUB_QUOTE_STALE_SECONDS=600
# One API key can only hold one Finnhub WebSocket connection. Keep one API worker.
FINNHUB_WEBSOCKET_ENABLED=true
# Tiger Securities individual-stock quote authorization. Server-side only.
TIGER_QUOTE_AUTHORIZATION=
TIGER_QUOTE_BASE_URL=https://hq2.skytigris.cn
TIGER_DEPTH_BASE_URL=https://hq-depth.skytigris.cn
TIGER_NEWS_BASE_URL=https://stock-news.laohu8.com
TIGER_QUOTE_TIMEOUT_SECONDS=5
TIGER_QUOTE_CACHE_SECONDS=2
TIGER_QUOTE_STALE_SECONDS=900
TIGER_NEWS_CACHE_SECONDS=60
# Refresh Binance TradFi exchangeInfo into the security master every hour.
TRADFI_UNIVERSE_SYNC_SECONDS=3600

MONITOR_SYMBOLS_CONFIG=config/tradfi_symbols.json
