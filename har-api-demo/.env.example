# Local server only: reads the request template and authorization from your HAR.
MARKET_HAR_PATH=D:/path/to/capture.har
STOCK_HAR_PATH=D:/path/to/stock-detail-capture.har

# Browser-safe settings. Never place third-party tokens in VITE_ variables.
VITE_MARKET_LIVE_ENABLED=false
VITE_MARKET_DATA_URL=/api/market/indices
VITE_STOCK_DATA_URL=/api/stock
